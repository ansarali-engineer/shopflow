{
  "info": {
    "_postman_id": "c0b9a2c6-11f4-4d90-a6b7-5f27bf793001",
    "name": "ShopFlow API",
    "description": "Postman collection for the ShopFlow Django REST API. Set baseUrl and credentials in collection variables. Register or log in to save accessToken and refreshToken automatically. Replace example IDs with IDs from your database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "newPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "1",
